<package name="beast-mosse" version="0.0.2">
    <depends on="BEAST.base" atleast="2.7.0"/>
    <depends on="BEAST.app"  atleast="2.7.0"/>
    <depends on="BEASTLabs"  atleast="2.0.3"/>

    <service type="beast.base.core.BEASTInterface">
        <provider classname="mosse.ConstantLinkFn"/>
        <provider classname="mosse.CustomSubstitutionModel"/>
        <provider classname="mosse.LogisticFunction"/>
        <provider classname="mosse.MosseDistribution"/>
        <provider classname="mosse.MosseTipLikelihood"/>
        <provider classname="mosse.MosseTreeLikelihood"/>
        <provider classname="mosse.MosseTreeLikelihoodMT"/>
        <provider classname="mosse.MosseTreeLikelihoodBuffered"/>
        <provider classname="mosse.MosseTreeLikelihoodBufferedMT"/>
    </service>
</package>