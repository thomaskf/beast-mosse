CC=gcc
JAVA_HOME := $(shell /usr/libexec/java_home)
CFLAGS=-I. -g -O2 -I$(JAVA_HOME)/include/ -I$(JAVA_HOME)/include/darwin/ -Werror
DEPS = mosse-eqs-fftC.h quasse_eqs-fftC.h rfftw.h
OBJ = main.o
LFLAGS = -shared -fPIC

%.o: %.c $(DEPS)
	$(CC) -c -o $@ $< $(CFLAGS)

libtest.dylib: $(OBJ)
	$(CC) -o $@ $^ $(CFLAGS) $(LFLAGS) -lm -lfftw3


.PHONY: clean

clean:
	rm -f *.o main
