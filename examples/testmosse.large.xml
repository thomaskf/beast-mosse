<beast version='2.0'
    namespace='beast.base.evolution.alignment:beast.pkgmgmt:beast.base.core:beast.base.inference:beast.base.evolution.tree.coalescent:beast.pkgmgmt:beast.base.core:beast.base.inference.util:beast.evolution.nuc:beast.base.evolution.operator:beast.base.inference.operator:beast.base.evolution.sitemodel:beast.base.evolution.substitutionmodel:beast.base.evolution.likelihood'>

    <!-- The sequence alignment                                                  -->
    <!-- ntax=20 nchar=2000                                                      -->
    <!-- npatterns=360                                                           -->
    <data
        id="alignment" dataType="nucleotide">
        <sequence taxon="sp1">
        
        </sequence>
        <sequence taxon="sp2">
        
        </sequence>
        <sequence taxon="sp3">
        
        </sequence>
        <sequence taxon="sp4">
        
        </sequence>
        <sequence taxon="sp5">
        
        </sequence>
        <sequence taxon="sp6">
        
        </sequence>
        <sequence taxon="sp7">
        
        </sequence>
        <sequence taxon="sp8">
        
        </sequence>
        <sequence taxon="sp9">
        
        </sequence>
        <sequence taxon="sp10">
        
        </sequence>
        <sequence taxon="sp11">
        
        </sequence>
        <sequence taxon="sp12">
        
        </sequence>
        <sequence taxon="sp13">
        
        </sequence>
        <sequence taxon="sp14">
        
        </sequence>
        <sequence taxon="sp15">
        
        </sequence>
        <sequence taxon="sp16">
        
        </sequence>
        <sequence taxon="sp17">
        
        </sequence>
        <sequence taxon="sp18">
        
        </sequence>
        <sequence taxon="sp19">
        
        </sequence>
        <sequence taxon="sp20">
        
        </sequence>
    </data>

    <taxonset
        id="taxonset" spec="beast.base.evolution.alignment.TaxonSet">
        <taxon id="sp1" spec="Taxon" />
        <taxon id="sp2" spec="Taxon" />
        <taxon id="sp3" spec="Taxon" />
        <taxon id="sp4" spec="Taxon" />
        <taxon id="sp5" spec="Taxon" />
        <taxon id="sp6" spec="Taxon" />
        <taxon id="sp7" spec="Taxon" />
        <taxon id="sp8" spec="Taxon" />
        <taxon id="sp9" spec="Taxon" />
        <taxon id="sp10" spec="Taxon" />
        <taxon id="sp11" spec="Taxon" />
        <taxon id="sp12" spec="Taxon" />
        <taxon id="sp13" spec="Taxon" />
        <taxon id="sp14" spec="Taxon" />
        <taxon id="sp15" spec="Taxon" />
        <taxon id="sp16" spec="Taxon" />
        <taxon id="sp17" spec="Taxon" />
        <taxon id="sp18" spec="Taxon" />
        <taxon id="sp19" spec="Taxon" />
        <taxon id="sp20" spec="Taxon" />
    </taxonset>

    <tree
        id='tree' spec='beast.base.evolution.tree.TreeParser'
        IsLabelledNewick='true'
        newick='(((sp2:1.049838447,(sp4:0.6939605846,(sp19:0.01462697391,sp20:0.01462697391)nd13:0.6793336107)nd5:0.3558778628)nd3:0.4268244178,((((sp11:0.1487890344,sp12:0.1487890344)nd18:0.1609632737,sp7:0.3097523081)nd8:0.5893893643,((sp5:0.5746148967,((sp17:0.05206627524,sp18:0.05206627524)nd19:0.107884737,sp10:0.1599510123)nd14:0.4146638844)nd10:0.1831082415,sp3:0.7577231382)nd9:0.1414185342)nd6:0.08707255494,(((sp6:0.3752693329,(sp8:0.1716235721,sp9:0.1716235721)nd17:0.2036457608)nd15:0.03000869401,(sp15:0.06826060454,sp16:0.06826060454)nd16:0.3370174224)nd11:0.3270523139,(sp13:0.08543504527,sp14:0.08543504527)nd12:0.6468952955)nd7:0.2538838865)nd4:0.4904486378)nd2:1.522943414,sp1:2.999606279)nd1'
        taxa='@alignment' />

    <MosseTipLikelihood id="mossetiplikelihood"
        spec="mosse.MosseTipLikelihood"
        subst="0.0" logscale="false">
        <epsilon id="epsilon" spec="parameter.RealParameter">0.01</epsilon>
        <beta id="beta" spec="parameter.RealParameter">1.0</beta>
    </MosseTipLikelihood>

    <JukesCantor
        id="JC" spec="beast.base.evolution.substitutionmodel.JukesCantor" />

    <SiteModel
        id="sitemodel" spec="beast.base.evolution.sitemodel.SiteModel"
        mutationRate="1.0" substModel="@JC"
        gammaCategoryCount="1.0" />

    <MosseDistribution id="treemodel"
        spec="mosse.MosseDistribution" tree="@tree"
        nx="1024" dx="0.0001" drift="0.0" diffusion="0.001" dt="0.01" width="5" resolution="4" threads="32" />

    <LogisticFunction
        id="logfunc" spec="mosse.LogisticFunction" curveYBaseValue="0.1"
        curveMaxY="0.2" sigmoidMidpoint="0.0" logisticGrowthRate="2.5" />

    <ConstantLinkFn
        id="constfunc" spec="mosse.ConstantLinkFn" yV="0.03" />

    <run
        chainLength="10" id="mcmc" spec="MCMC">

        <state id="state" storeEvery="10000">
            <!-- <stateNode idref="epsilon" /> -->
            <stateNode idref="tree" />
        </state>

        <distribution id="posterior" spec="beast.base.inference.CompoundDistribution">

            <distribution id="likelihood" spec="beast.base.inference.CompoundDistribution">
                <distribution id="mossetreelikelihood"
                    spec="mosse.MosseTreeLikelihoodBufferedMT"
                    data="@alignment" tree="@tree" siteModel="@sitemodel"
                    tipModel="@mossetiplikelihood" treeModel="@treemodel"
                    lambdaFunc="@logfunc" muFunc="@constfunc">
                    <traits id="traitset"
                        spec="beast.base.evolution.tree.TraitSet"
                        traitname="trait0" taxa="@taxonset"
                        value="sp1=0.0682157376607991,sp2=0.0577309817155646,sp3=0.0876073021060713,sp4=0.0170916723535904,sp5=0.0643209355960926,sp6=0.0251726388225066,sp7=0.0594171378771152,sp8=0.0356801813381377,sp9=0.040185325654931,sp10=0.063514025003301,sp11=0.0622700484555567,sp12=0.0392252029579882,sp13=0.065881283213531,sp14=0.0840818215237834,sp15=0.0441763722344705,sp16=0.0350654003746295,sp17=0.083072022511891,sp18=0.077832673112264,sp19=0.0326603328779717,sp20=0.0207063844999307" />
                </distribution>
            </distribution>

            <!-- START prior-->
            <distribution id="prior" spec="beast.base.inference.CompoundDistribution">
                <distribution id="tree.prior" spec="beast.base.evolution.tree.coalescent.Coalescent">
                    <tree idref="tree"/>
                    <populationModel id="popModel" spec="ConstantPopulation">
                        <parameter id="popSize" name="popSize">1.0</parameter>
                    </populationModel>
                </distribution>            
                <!--
                <distribution id="EpsilonPrior" spec="beast.base.inference.distribution.Prior" x="@epsilon">
                    <distr id="LogNormal.Epsilon" spec="beast.base.inference.distribution.LogNormalDistributionModel" offset="0.0" meanInRealSpace="false">
                        <parameter name="M" value="1.0" estimate="false" />
                        <parameter name="S" value="1.0" estimate="false" />
                    </distr>
                </distribution>
                -->
            </distribution>
            <!-- END prior-->
        </distribution>
        
        <!--<operator id="TreeScaler" spec="ScaleOperator" tree="@tree" scaleFactor="0.75" weight="3.0"/>-->

        <!-- SubtreeSlide: local node-height / branch-length move, no topology change -->
        <operator id="SubtreeSlide.t" spec="SubtreeSlide" tree="@tree" weight="3.0"/>

        <!-- Uniform: pick an internal node, move its height uniformly between parent/children -->
        <!--<operator id="Uniform.t" spec="Uniform" tree="@tree" weight="3.0"/> -->

        <!--
        <operator id="EpsilonScaler" spec="ScaleOperator" parameter="@epsilon"
            scaleFactor="0.75" weight="3.0" />
        -->

        <logger logEvery="1" fileName="examples/test.$(seed).log" model="@likelihood">
            <log idref='posterior' />
            <log idref='likelihood' />
            <log idref="mossetreelikelihood" />
            <log idref="tree" />
            <!-- <log idref="beta" />
            <log idref="epsilon" /> -->
        </logger>
    </run>

</beast>
